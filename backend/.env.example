# Owner: mousamdas156@gmail.com
# KarobarOne Backend — Required Environment Variables
# Copy this file to .env and fill in your values

# Database
databaseUrl=postgresql+asyncpg://user:password@localhost:5432/karobar_one

# Security
jwtSecretKey=CHANGE_ME_TO_A_STRONG_SECRET_KEY
jwtAlgorithm=HS256
accessTokenExpireMinutes=30
refreshTokenExpireDays=7

# App
appName=KarobarOne
appVersion=1.0.0
apiPrefix=/api/v1
debug=true
logLevel=INFO

# Comma-separated list of allowed frontend origins for CORS (no trailing slash)
corsOrigins=http://localhost:3000,https://karobar-one-ten.vercel.app

# Defaults (used for fallback IDs)
defaultTenantId=00000000-0000-0000-0000-000000000000
defaultStoreId=00000000-0000-0000-0000-000000000000

# AI Generation
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
AI_PROVIDER=gemini

# Email / OTP delivery (SMTP — free via a Gmail app password)
# Create one at https://myaccount.google.com/apppasswords (requires 2-Step Verification)
# NOTE: case-sensitive — these power app/core/mailer.py (the /auth register+login OTP flow).
smtpHost=smtp.gmail.com
smtpPort=465
emailAddress=
emailPassword=
emailFromName=KarobarOne

# Legacy email OTP sender used ONLY by the separate /api/v1/github/otp module
# (app/services/github/otpService.py). Distinct from emailAddress/emailPassword
# above — this is a different, older OTP system with its own in-memory store.
EMAIL_ADDRESS=
EMAIL_PASSWORD=

# Razorpay payment gateway (used by app/services/github/razorpayService.py)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Google Calendar OAuth (used by app/services/github/calendarService.py)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# Shiprocket shipping integration (used by app/core/configGithub.py)
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=
SHIPROCKET_BASE_URL=https://apiv2.shiprocket.in/v1/external

# Blog Agent (LangGraph + Cerebras + Tavily search) — app/apps/blogAgent
CEREBRAS_API_KEY=
TAVILY_API_KEY=

# Ported products catalog module (app/productsPorted) — separate Settings class.
# IMPORTANT: app/productsPorted/core/config.py currently ships hardcoded
# fallback values for DATABASE_URL and DROPBOX_ACCESS_TOKEN. Treat those as
# compromised, rotate them, and always set real values here instead of
# relying on the file's defaults.
DATABASE_URL=
SECRET_KEY=CHANGE_ME_TO_A_STRONG_SECRET_KEY
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
DROPBOX_ACCESS_TOKEN=
MAX_IMAGES_PER_PRODUCT=5
MAX_IMAGE_SIZE_BYTES=5242880
